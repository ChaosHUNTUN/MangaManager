<Window x:Class="MangaManager.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MangaManager" Height="720" Width="920"
        MinHeight="500" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Closing="Window_Closing" Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_Drag">

    <Window.Resources>
        <!-- ====== 调色板 ====== -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0C0C1D"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#111128"/>
        <SolidColorBrush x:Key="BgCard" Color="#181838"/>
        <SolidColorBrush x:Key="BgInput" Color="#0A0A1A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#1E1E3E"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2A2A4A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentLight" Color="#A78BFA"/>
        <SolidColorBrush x:Key="Success" Color="#10B981"/>
        <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
        <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Info" Color="#3B82F6"/>

        <!-- ====== 主按钮 (Primary) ====== -->
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B5CF6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 操作按钮 (Action) ====== -->
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 图标按钮 (Icon) ====== -->
        <Style TargetType="Button" x:Key="IconBtn">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#1E1E3E"/>
            <Setter Property="Foreground" Value="#8B5CF6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 快捷入口按钮 ====== -->
        <Style TargetType="Button" x:Key="QuickLinkBtn">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#0F2A1A"/>
            <Setter Property="Foreground" Value="#6EE7B7"/>
            <Setter Property="BorderBrush" Value="#3022C55E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A3A2A"/>
                    <Setter Property="BorderBrush" Value="#5044ee77"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 危险按钮 ====== -->
        <Style TargetType="Button" x:Key="DangerBtn">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 幽灵按钮 (Ghost) ====== -->
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A4A"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1E3E"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 任务操作按钮 (28x28 小按钮) ====== -->
        <Style TargetType="Button" x:Key="TaskBtn">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 标题栏关闭按钮 ====== -->
        <Style TargetType="Button" x:Key="TitlebarBtn">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ====== 状态徽标 (Pill) ====== -->
        <Style TargetType="Border" x:Key="StatusPill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <!-- ====== 章节卡片容器 ====== -->
        <Style TargetType="Border" x:Key="SectionCard">
            <Setter Property="Background" Value="#111128"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#1E1E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ====== 子卡片 ====== -->
        <Style TargetType="Border" x:Key="SubCard">
            <Setter Property="Background" Value="#181838"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="BorderBrush" Value="#1E1E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ====== 滚动条深色主题 ====== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3B3B6A" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ====== 主容器 ====== -->
    <Border CornerRadius="12" Background="{StaticResource BgPrimary}"
            BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== 标题栏 ========== -->
            <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                    CornerRadius="12,12,0,0" Padding="18,11"
                    MouseLeftButtonDown="Window_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📚" FontSize="18"/>
                        <TextBlock Text="MangaManager" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0"/>
                        <Border Background="#207C3AED" CornerRadius="8" Padding="7,2" Margin="10,0,0,0"
                                BorderBrush="#408B5CF6" BorderThickness="1">
                            <TextBlock Text="v2.0" FontSize="10" Foreground="{StaticResource AccentLight}"/>
                        </Border>

                        <!-- 分割线 -->
                        <Border Width="1" Background="{StaticResource BorderLight}" Margin="16,2,12,2"/>

                        <!-- 快捷入口内联到标题栏 -->
                        <Button Content="🌐 前端页面" Style="{StaticResource GhostBtn}"
                                Click="OpenWeb_Click" ToolTip="打开前端页面 (http://localhost:5173)"/>
                        <Button Content="🐱 本地画廊" Style="{StaticResource GhostBtn}" Margin="6,0,0,0"
                                Click="OpenLocalGallery_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="─" Style="{StaticResource TitlebarBtn}"
                                Foreground="#64748B" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource TitlebarBtn}"
                                Foreground="#94A3B8" Click="Close_Click" x:Name="BtnClose"
                                Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 主体 ========== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,22">
                <StackPanel>

                    <!-- ====== 1. 服务管理 ====== -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="服务管理" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource StatusPill}" Margin="12,0,0,0"
                                            Background="{Binding ElementName=TxtGlobalStatus, Path=Tag, FallbackValue=#1878350F}">
                                        <TextBlock x:Name="TxtGlobalStatus" Text="● 检查中..." FontSize="11"
                                                   Foreground="{StaticResource Warning}" Tag="#1878350F"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="▶ 全部启动" Style="{StaticResource PrimaryBtn}" FontSize="11"
                                            Padding="12,6" Click="BtnStartAll_Click" Background="#059669"/>
                                    <Button Content="⏹ 全部停止" Style="{StaticResource DangerBtn}"
                                            Click="BtnStopAll_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel>
                                <!-- Web 前端卡片 -->
                                <Border Style="{StaticResource SubCard}" Width="268">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#78350F20" CornerRadius="6" Padding="5" Width="30" Height="30">
                                                <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Web 前端" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="Vite Dev Server" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Warning}"
                                                             x:Name="UiStatusDot" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtUiStatus" Text="检查中..." FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                                <TextBlock Text="localhost:5173" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnUiStart" Content="▶ 启动"
                                                    Style="{StaticResource ActionBtn}" Background="#059669"
                                                    Click="BtnUiStart_Click"/>
                                            <Button x:Name="BtnUiStop" Content="⏹ 停止"
                                                    Style="{StaticResource ActionBtn}" Background="#DC2626"
                                                    Margin="6,0,0,0" Click="BtnUiStop_Click"/>
                                            <Button Content="🔄" Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                                    Click="BtnUiRestart_Click" ToolTip="重启"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- API 后端卡片 -->
                                <Border Style="{StaticResource SubCard}" Width="268">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1D4ED820" CornerRadius="6" Padding="5" Width="30" Height="30">
                                                <TextBlock Text="🔌" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="API 后端" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="ASP.NET Core 9" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Warning}"
                                                             x:Name="ApiStatusDot" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtApiStatus" Text="检查中..." FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtApiEndpoint" Text="localhost:5208" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnApiStart" Content="▶ 启动"
                                                    Style="{StaticResource ActionBtn}" Background="#059669"
                                                    Click="BtnApiStart_Click"/>
                                            <Button x:Name="BtnApiStop" Content="⏹ 停止"
                                                    Style="{StaticResource ActionBtn}" Background="#DC2626"
                                                    Margin="6,0,0,0" Click="BtnApiStop_Click"/>
                                            <Button Content="🔄" Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                                    Click="BtnApiRestart_Click" ToolTip="重启"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ====== 2. 下载任务 ====== -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="下载任务" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDownloadSummary" Text="" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="BtnRestartFailed" Content="🔄 重启全部失败"
                                        Style="{StaticResource GhostBtn}"
                                        Background="#2078350F" Foreground="{StaticResource Warning}"
                                        BorderBrush="#40F59E0B"
                                        Click="BtnRestartFailed_Click" Visibility="Collapsed"
                                        HorizontalAlignment="Right"/>
                            </Grid>

                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                                    Padding="14,12" Margin="0,0,0,6"
                                                    BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <!-- 标题行 -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#CBD5E1" MaxWidth="380"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                                                    Background="{Binding StatusBgBrush}">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                           Foreground="{Binding StatusColor}"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 信息行 -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                                                <Run Text="{Binding DownloadedPages}"/>
                                                                <Run Text=" / "/>
                                                                <Run Text="{Binding TotalPages}"/>
                                                                <Run Text=" 页"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding SpeedText}" FontSize="11"
                                                                       Foreground="{StaticResource Info}" Margin="12,0,0,0"
                                                                       FontWeight="SemiBold"
                                                                       Visibility="{Binding SpeedVisible}"/>
                                                            <TextBlock Text="{Binding ErrorMsg}" FontSize="10"
                                                                       Foreground="{StaticResource Danger}"
                                                                       Margin="12,0,0,0" MaxWidth="220"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding ErrorVisible}"/>
                                                        </StackPanel>

                                                        <!-- 进度条 -->
                                                        <Border Height="1" Margin="0,7,0,0"/>
                                                        <Grid Height="5">
                                                            <Border CornerRadius="3"
                                                                    Background="{StaticResource BgInput}"/>
                                                            <Border CornerRadius="3"
                                                                    Background="{Binding ProgressBrush}"
                                                                    HorizontalAlignment="Stretch"
                                                                    RenderTransformOrigin="0,0">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding ProgressFraction}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- 操作按钮 -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <Button Content="⏸" Style="{StaticResource TaskBtn}"
                                                                Background="#308B5CF6" Foreground="{StaticResource AccentLight}"
                                                                Click="BtnPauseTask_Click" Tag="{Binding Gid}"
                                                                Visibility="{Binding PauseVisible}"/>
                                                        <Button Content="▶" Style="{StaticResource TaskBtn}"
                                                                Background="#303B82F6" Foreground="{StaticResource Info}"
                                                                Click="BtnResumeTask_Click" Tag="{Binding Gid}"
                                                                Margin="4,0,0,0"
                                                                Visibility="{Binding ResumeVisible}"/>
                                                        <Button Content="↻" Style="{StaticResource TaskBtn}"
                                                                Background="#30F59E0B" Foreground="{StaticResource Warning}"
                                                                Click="BtnRestartTask_Click" Tag="{Binding Gid}"
                                                                Margin="4,0,0,0"
                                                                Visibility="{Binding RestartVisible}"/>
                                                        <Button Content="✕" Style="{StaticResource TaskBtn}"
                                                                Background="#30EF4444" Foreground="#FCA5A5"
                                                                Click="BtnRemoveTask_Click" Tag="{Binding Gid}"
                                                                Margin="4,0,0,0"
                                                                Visibility="{Binding RemoveVisible}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="TxtNoTasks" Text="✨ 暂无下载任务" FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ====== 3. 运行日志 ====== -->
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="运行日志" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Button Content="🗑 清空" Style="{StaticResource GhostBtn}"
                                        Margin="12,0,0,0" Padding="8,4"
                                        Click="ClearLog_Click"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{StaticResource BgInput}"
                                    CornerRadius="7" BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1">
                                <TextBox x:Name="TxtLog" Margin="12,10"
                                         Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         MinHeight="120" MaxHeight="200"/>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
