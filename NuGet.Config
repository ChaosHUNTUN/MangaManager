<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- 本机 Visual Studio 残留的回退包目录（重装前路径 D:\Coder\Share\NuGetPackages 已不存在），
       这里清空继承的 fallbackPackageFolders，避免 restore/构建报 NU1301 -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
